<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyTitle>Neo.ConsoleUI</AssemblyTitle>
    <AssemblyName>neo-tui</AssemblyName>
    <OutputType>Exe</OutputType>
    <Description>Cross-platform console UI for neo-cli (menus, hotkeys, line editing).</Description>
    <RootNamespace>Neo.ConsoleUI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neo.CLI\Neo.CLI.csproj" />
    <ProjectReference Include="..\Neo.ConsoleService\Neo.ConsoleService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Neo.CLI\config*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
